{
  "id": "cutscene-no-bars",
  "name": {
    "en": "Cutscenes without black bars",
    "pt": "Cutscenes sem barras pretas"
  },
  "description": {
    "en": "During cutscenes the game covers the picture with black bars: side bars down to 4:3, plus top and bottom bars.\nThis mod removes the side and top bars. The bottom strip is only drawn while a subtitle is on screen.\n\nThings that used to be hidden by the bars may show up at the edges.",
    "pt": "Nas cutscenes o jogo cobre a imagem com barras pretas: laterais até 4:3, mais uma em cima e outra embaixo.\nEste mod remove as laterais e a de cima. A faixa de baixo só aparece enquanto há legenda na tela.\n\nPode aparecer nas bordas algo que antes ficava escondido pelas barras."
  },
  "version": "1.0",
  "gameBuild": "CL 583774 / CL 583916",
  "patches": [
    {
      "rva": "0x1286EE",
      "note": "HUD::DrawLetterBox: only the bottom strip, and only while a subtitle is shown",
      "original": "",
      "patched": ""
    }
  ]
}
